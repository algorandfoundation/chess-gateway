{
  "name": "chess-gateway",
  "version": "0.0.2",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:algorandfoundation/chess-gateway.git"
  },
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"vault/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"vault/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test,vault}/**/*.ts\" --ignore-pattern \"volumes/*\"",
    "lint:fix": "eslint --fix \"{src,apps,libs,test,vault}/**/*.ts\" --ignore-pattern \"volumes/*\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:jsonSummary": "jest --coverage --coverageReporters json-summary",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "vault:development:init": "npx tsx vault/development-init.ts"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "10.0.0-beta.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.16",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/typeorm": "^11.0.1",
    "@thallesp/nestjs-better-auth": "^2.6.0",
    "axios": "^1.8.2",
    "better-auth": "^1.6.9",
    "better-sqlite3": "^12.9.0",
    "bip39": "^3.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "js-sha512": "^0.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^6.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-client-generator": "7.0.0-alpha.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/js-sha512": "^0.8.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "jest-create-mock-instance": "^2.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.1.3"
  },
  "resolutions": {
    "minimatch": "^5.1.8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "mjs"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../libs"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ],
      "^.+\\.mjs$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/../test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!@algorandfoundation/algokit-utils|@noble/hashes|@noble/ed25519|@thallesp/nestjs-better-auth|better-auth)"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/coverage/"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
