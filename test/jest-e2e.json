{
  "moduleFileExtensions": ["js", "mjs", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "extensionsToTreatAsEsm": [".ts", ".mts"],
  "transform": {
    "^.+\\.m?tsx?$": ["ts-jest", { "useESM": true, "tsconfig": { "module": "ESNext", "moduleResolution": "bundler", "allowJs": true } }]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transformIgnorePatterns": ["node_modules/(?!@algorandfoundation/algokit-utils|@noble/hashes|@noble/ed25519|@thallesp/nestjs-better-auth|better-auth)"]
}
