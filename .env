NODE_ENV=development

# Transit engine path values for the different roles
VAULT_TRANSIT_USERS_PATH=pawn/users
VAULT_TRANSIT_MANAGERS_PATH=pawn/managers

# Default vault user
VAULT_MANAGER_KEY=manager

# Usually docker network domain
# Change if you are using a different network or want to connect to a remote vault
VAULT_BASE_URL=http://localhost:8200
VAULT_LOCAL_URL=http://localhost:8200
VAULT_NAMESPACE=

# DEFAULT ROLE ID and SECRET ID for the user to access the vault
# REPLACE WITH YOUR OWN VALUES
VAULT_ROLE_ID=someID
VAULT_SECRET_ID=someID

# Uses local instance of vault
CLI_USE_LOCAL_VAULT=true

# Network values — defaults target the AlgoKit localnet developer setup.
# `dockernet-v1` is the genesis-id used by `algokit localnet`. Switch to
# `testnet-v1.0`, `mainnet-v1.0`, or `fnet-v1` (with the matching hash and
# algod endpoint below) when targeting a public network. See CONTRIBUTING.md.
GENESIS_ID=dockernet-v1
GENESIS_HASH=xI8Xj/dY068VapY40murq4qdN7gb0BmyeECeCEBXbi4=

# Algod endpoint. Defaults to AlgoKit localnet (algod listens on 4001 with
# the dev token of 64 × 'a'). For algonode public endpoints use scheme=https,
# port=443, host=mainnet-api.algonode.cloud / testnet-api.algonode.cloud /
# fnet-api.4160.nodely.dev, token=''.
NODE_HTTP_SCHEME=http
NODE_HOST='localhost'
NODE_PORT=4001
NODE_TOKEN='aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'

# did:algo registry
# App id of the deployed `DIDAlgoStorage` smart contract on the active
# network. Use scripts/deploy-did-algo.ts to deploy a fresh instance —
# it prints the id you need to set here. Default below targets the
# algokit localnet developer setup.
DID_ALGO_APP_ID=1002

# Signing secret for the NestJS JwtModule (used by /v1/auth/token).
# Must be a non-empty string; dotenv treats a leading `#` as a comment
# so do NOT prefix with `#`. Rotate in production.
JWT_SECRET=dev-only-jwt-secret-change-me-please-32bytes

GOOGLE_CLIENT_ID=#'your-google-client-id'
GOOGLE_CLIENT_SECRET=#'your-google-client-secret'

# Public base URL of this service. Used by Better Auth (`baseURL` /
# `trustedOrigins`) and by the OID4VC issuer/verifier metadata.
BASE_URL=http://localhost:3000
SESSION_AUTH_SECRET=dev-only-session-auth-secret-change-me-32bytes

# Better-Auth manager user seeded by `vault/development-init.ts`
# (`seedManagerBetterAuthUser`). The seed is idempotent: an existing
# row with this email is promoted to `role=manager`, otherwise a new
# Better-Auth user is created. Update profile fields later via
# `PUT /v1/auth/user/:userId`. The manager identity is logically bound
# to the singleton `pawn/managers/manager` transit key through the
# AppRole credentials in `VAULT_ROLE_ID` / `VAULT_SECRET_ID`.
MANAGER_EMAIL=manager@example.com
MANAGER_NAME=Manager

OID4VC_VAULT_ROLE_ID=someID
OID4VC_VAULT_SECRET_ID=someID
USER_VAULT_ROLE_ID=someID

USER_VAULT_ROLE_ID=someID
USER_VAULT_SECRET_ID=someID
